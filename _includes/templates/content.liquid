<div class="content-wrap">
    <div class="header d-flex flex-justify-between p-2 hide-lg hide-xl" aria-label="top navigation">
        <button id="toggle" aria-label="Toggle menu" class="btn-octicon p-2 m-0 text-white" type="button">
            <i class="fa fa-bars"></i>
        </button>
        <div class="title flex-1 d-flex flex-justify-center">
            <a class="h4 no-underline py-1 px-2 rounded-1" href="{{ site.baseurl }}/">{{ site.title }}</a>
        </div>
    </div>
    <div class="content p-3 p-sm-5">
        {% include templates/breadcrumbs.liquid %}
        <hr>
        <div role="main" itemscope="itemscope" itemtype="https://schema.org/Article">
            <div class="markdown-body" itemprop="articleBody">
                {%- comment -%}
                    Pages published from solids4foam link relative to their
                    place there; bin/sync-docs.sh resolves those links.
                {%- endcomment -%}
                {%- assign body = content -%}
                {%- for link in site.data.docs_links[page.path] -%}
                    {%- if link.page -%}
                        {%- assign href = link.page | relative_url -%}
                    {%- else -%}
                        {%- assign href = link.url -%}
                    {%- endif -%}
                    {%- assign from = 'href="' | append: link.from | append: '"' -%}
                    {%- assign to = 'href="' | append: href | append: '"' -%}
                    {%- assign body = body | replace: from, to -%}
                    {%- if link.src -%}
                        {%- assign from = 'src="' | append: link.from | append: '"' -%}
                        {%- assign to = 'src="' | append: link.src | append: '"' -%}
                        {%- assign body = body | replace: from, to -%}
                    {%- endif -%}
                {%- endfor -%}
                {{ body }}
            </div>
        </div>
        {% include templates/footer.liquid %}
    </div>
</div>
